[
 {
  "name": "path traversal bind",
  "view": {
   "services": {
    "a": {
     "image": "busybox:1",
     "volumes": [
      {
       "type": "bind",
       "source": "/srv/mirrors/pbm-x/../../etc",
       "target": "/t"
      }
     ]
    }
   }
  },
  "expect": {
   "ok": false,
   "codes": [
    "policy_hard"
   ],
   "has": [
    "policy_hard|path_ambiguous"
   ]
  }
 },
